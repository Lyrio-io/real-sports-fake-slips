# Set on the Railway real-sports-fake-slips service, never in browser Settings.
KALSHI_ENVIRONMENT=demo
KALSHI_API_KEY_ID=
# Complete PEM private key; actual newlines or literal \n are supported.
KALSHI_PRIVATE_KEY=
KALSHI_VIEWER_USER=
# Use a separate random password of at least 20 characters.
KALSHI_VIEWER_PASSWORD=
NODE_ENV=production

# Optional sourced sports research (server only)
ODDS_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
